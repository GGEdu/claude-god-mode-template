{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "MAX_THINKING_TOKENS": "10000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  },
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run test*)",
      "Bash(npm run build)",
      "Bash(npm install)",
      "Bash(npx --yes ecc-agentshield*)",
      "Bash(npx markdownlint*)",
      "Bash(npx markdownlint-cli2*)",
      "Bash(npx repomix*)",
      "Bash(npx prettier*)",
      "Bash(npx eslint*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git config --get *)",
      "Bash(python -m pytest*)",
      "Bash(python3 .claude/hooks/*.py)",
      "Bash(python3 ops/*.py)",
      "Bash(python3 -m json.tool)",
      "Bash(pip install -r requirements.txt)",
      "Bash(uv pip install*)",
      "Bash(uv sync*)",
      "Bash(ruff check*)",
      "Bash(ruff format*)",
      "Bash(make *)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(cat *.md)",
      "Bash(cat *.json)",
      "Bash(cat *.yaml)",
      "Bash(cat *.yml)",
      "Bash(grep -rn *)",
      "Bash(grep -E *)",
      "Bash(grep -l *)",
      "Bash(find . -type *)",
      "Bash(find . -name *)",
      "Bash(wc -l *)",
      "Bash(head -n *)",
      "Bash(tail -n *)",
      "Bash(diff *.md *.md)",
      "Bash(jq . *)",
      "Bash(jq -r *)",
      "Bash(cp *.md *.md)",
      "Bash(mkdir -p .claude/*)",
      "Bash(mkdir -p docs/*)",
      "Bash(chmod +x .claude/hooks/*)",
      "Bash(mv *.md *.md)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh repo *)",
      "Bash(gh search *)",
      "Bash(gh workflow *)",
      "Bash(gh label *)",
      "Read(/tmp/**)",
      "Bash(stat .claude/memory/*.md)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(git push --force*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ./*)"
    ],
    "additionalDirectories": [
      "./.claude/memory",
      "./.claude/rules",
      "./.claude/rules/common",
      "./.claude/hooks"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=.claude/hooks/hook-health-check.py; [ -f \"$f\" ] && python3 \"$f\" || echo '{\"decision\":\"allow\",\"reason\":\"hook not installed\"}'"
          },
          {
            "type": "command",
            "command": "f=.claude/hooks/plan-gate.py; [ -f \"$f\" ] && python3 \"$f\" || echo '{\"decision\":\"allow\",\"reason\":\"hook not installed\"}'"
          },
          {
            "type": "command",
            "command": "f=.claude/hooks/tdd-gate.py; [ -f \"$f\" ] && python3 \"$f\" || echo '{\"decision\":\"allow\",\"reason\":\"hook not installed\"}'"
          },
          {
            "type": "command",
            "command": "f=.claude/hooks/non-goal-guard.py; [ -f \"$f\" ] && python3 \"$f\" || echo '{\"decision\":\"allow\",\"reason\":\"hook not installed\"}'"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=.claude/hooks/hook-health-check.py; [ -f \"$f\" ] && python3 \"$f\" || echo '{\"decision\":\"allow\",\"reason\":\"hook not installed\"}'"
          },
          {
            "type": "command",
            "command": "f=.claude/hooks/plan-gate.py; [ -f \"$f\" ] && python3 \"$f\" || echo '{\"decision\":\"allow\",\"reason\":\"hook not installed\"}'"
          },
          {
            "type": "command",
            "command": "f=.claude/hooks/tdd-gate.py; [ -f \"$f\" ] && python3 \"$f\" || echo '{\"decision\":\"allow\",\"reason\":\"hook not installed\"}'"
          },
          {
            "type": "command",
            "command": "f=.claude/hooks/non-goal-guard.py; [ -f \"$f\" ] && python3 \"$f\" || echo '{\"decision\":\"allow\",\"reason\":\"hook not installed\"}'"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=.claude/hooks/commit-checklist.py; [ -f \"$f\" ] && python3 \"$f\" || echo '{\"decision\":\"allow\",\"reason\":\"hook not installed\"}'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=.claude/hooks/plan-drift-detector.py; [ -f \"$f\" ] && python3 \"$f\" || echo '{\"decision\":\"allow\",\"reason\":\"hook not installed\"}'"
          },
          {
            "type": "command",
            "command": "f=.claude/hooks/auto-format.sh; [ -f \"$f\" ] && bash \"$f\" || echo '{\"decision\":\"allow\",\"reason\":\"hook not installed\"}'"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=.claude/hooks/plan-drift-detector.py; [ -f \"$f\" ] && python3 \"$f\" || echo '{\"decision\":\"allow\",\"reason\":\"hook not installed\"}'"
          },
          {
            "type": "command",
            "command": "f=.claude/hooks/auto-format.sh; [ -f \"$f\" ] && bash \"$f\" || echo '{\"decision\":\"allow\",\"reason\":\"hook not installed\"}'"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "f=.claude/hooks/session-read-logger.py; [ -f \"$f\" ] && python3 \"$f\" || echo '{\"decision\":\"allow\",\"reason\":\"hook not installed\"}'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=.claude/hooks/session-consolidate.sh; g=$HOME/.claude/hooks/session-consolidate.sh; if [ -f \"$f\" ]; then bash \"$f\"; elif [ -f \"$g\" ]; then bash \"$g\"; else echo '{\"decision\":\"allow\",\"reason\":\"session-consolidate not installed\"}'; fi"
          }
        ]
      }
    ]
  }
}
