# Secretos — NUNCA subir
.env
.env.*
secrets/
*.key
*.pem

# Settings locales (preferencias personales)
.claude/settings.local.json

# Artefactos generados por dev-stack (stack-specific, se generan en el proyecto destino)
.claude/agents/
.claude/commands/
.claude/rules/

# Memoria: vault (Obsidian) se commitea; grafo y cache de Graphify/MemPalace no
graphify-out/
entities.json
!vault/

# Memoria de sesión de Claude (se regenera automáticamente vía hook)
# Las decisiones permanentes van en docs/src/ — no en memory/
.claude/memory/*.md
.claude/memory/*.log
.claude/memory/lessons/*.yaml
!.claude/memory/lessons/_index.yaml
!.claude/memory/lessons/README.md

# Estado de la state machine (gitignored — local de sesión, no compartido)
.claude/state.yaml
.claude/state.yaml.lock
.claude/session-reads.log

# Memoria personal por developer (Claude Code la carga junto a CLAUDE.md)
CLAUDE.local.md

# Worktrees de agentes (temporales, se crean/eliminan automáticamente)
.claude/worktrees/

# Caché local (search indexes, embeddings, etc.)
.cache/

# Tentacle work areas — todo.md es estado local; CONTEXT.md y worktree/ son locales también
.tentacles/*/todo.md
.tentacles/*/worktree/

# Snapshots inmutables del PLAN (Sintesis.md §1.8)
PLAN.v*.md
.claude/plans/PLAN.v*.md

# Dependencias
node_modules/
__pycache__/
*.pyc
.venv/

# Datos de arscontexta (se generan localmente)
.arscontexta/

# Configs MCP locales (personales, con tokens o paths específicos del usuario)
.mcp.local.json

# Outputs temporales
output/
dist/
build/

# Proyectos externos para análisis (no pertenecen al template)
projects/
proyectos/

# OS
.DS_Store
Thumbs.db

# MemPalace per-project files (issue #185)
mempalace.yaml

# Graphify: `graphify hook install` escribe estos con una ruta absoluta al
# intérprete Python de ESTA máquina (uv tool / venv) hardcodeada — nunca
# portable entre máquinas, no commitear (a diferencia de pre-commit/pre-push,
# que sí son del repo).
.githooks/post-commit
.githooks/post-checkout
